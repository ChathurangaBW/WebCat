{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@webcat/core": ["packages/core/src/index.ts"],
      "@webcat/mcp-gateway": ["packages/mcp-gateway/src/index.ts"],
      "@webcat/agent-profiles": ["packages/agent-profiles/src/index.ts"],
      "@webcat/agent-runtime": ["packages/agent-runtime/src/index.ts"]
    }
  }
}
