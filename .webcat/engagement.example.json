{
  "schemaVersion": 1,
  "id": "engagement_replace_me",
  "name": "Authorized Web Application Assessment",
  "authorizedBy": "REPLACE_WITH_AUTHORIZER",
  "authorizationReference": "REPLACE_WITH_TICKET_OR_CONTRACT",
  "startsAt": "2026-01-01T00:00:00.000Z",
  "expiresAt": "2026-01-08T00:00:00.000Z",
  "mode": "observe",
  "allow": [
    {
      "id": "primary-target",
      "hosts": [
        "app.example.test"
      ],
      "schemes": [
        "https"
      ],
      "paths": [
        "/**"
      ],
      "operations": [
        "passive"
      ]
    }
  ],
  "deny": [
    {
      "id": "sensitive-actions",
      "hosts": [
        "app.example.test"
      ],
      "paths": [
        "/logout",
        "/admin/delete/**"
      ],
      "operations": [
        "active",
        "high",
        "destructive"
      ]
    }
  ],
  "rateLimit": {
    "requestsPerMinute": 30,
    "maxParallel": 2
  },
  "riskPolicy": {
    "allowHighRisk": false,
    "allowDestructive": false,
    "approvalTtlMinutes": 20
  }
}
