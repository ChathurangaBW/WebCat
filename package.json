{
  "name": "webcat",
  "version": "1.0.0",
  "description": "Terminal-native AI swarm for authorized web application security assessment",
  "license": "MIT",
  "type": "module",
  "bin": {
    "webcat": "bin/webcat.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md",
    ".webcat/*.example.json",
    "docs/"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node test/e2e.mjs",
    "start": "node bin/webcat.mjs",
    "check": "npm test && npm run smoke"
  }
}
